# Copy to .env for local Docker Compose: `cp .env.example .env`.
# These are development-only defaults, not secrets — safe to keep filled in here so
# `docker compose up` works with zero setup. Never reuse them anywhere but a local machine.

# --- Postgres bootstrap (docker-compose's db service; see db/README.md) -----------------
POSTGRES_SUPERUSER_PASSWORD=app_migrator_dev_password

# --- Set once by the baseline migration; also used directly by db/roles/*.sql if you ----
# --- ever run those manually against this local database -------------------------------
APP_USER_PASSWORD=app_user_dev_password
APP_WORKER_PASSWORD=app_worker_dev_password

# --- App runtime -------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=DEBUG
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://app_user:app_user_dev_password@localhost:5432/cineatelie
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Alembic (only needed if you run `alembic upgrade head` outside docker-compose) ------
MIGRATION_DATABASE_URL=postgresql+psycopg://app_migrator:app_migrator_dev_password@localhost:5432/cineatelie

# --- Identity (ADR-006) — fill from the Supabase project's Settings > API page. No local- --
# --- Docker equivalent exists (Supabase Auth is not part of docker-compose), so these are --
# --- blank here rather than given a fake default; platform/auth fails at wiring time, not --
# --- at import time, if a route that needs them is actually hit while they're unset. ------
AUTH_PROVIDER=supabase
AUTH_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
AUTH_JWT_ISSUER=https://<ref>.supabase.co/auth/v1
AUTH_JWT_AUDIENCE=authenticated
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Zero-trust edge verification (ADR-015) — only enforced when APP_ENV=production; -----
# --- blank locally is fine, EdgeVerificationMiddleware is a no-op outside production. ------
EDGE_SHARED_SECRET=

# --- Only if 5432 or 8000 are already taken on your machine -----------------------------
# LOCAL_POSTGRES_HOST_PORT=5433
# API_HOST_PORT=8001
